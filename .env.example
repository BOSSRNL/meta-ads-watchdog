# Copy this file to .env (next to your config file) and fill it in.
# Never commit .env: it is in .gitignore.

# A Meta access token with the ads_management permission.
# Use a System User token from Business Settings so it does not expire.
META_ACCESS_TOKEN=

# Discord webhook URLs (Server Settings > Integrations > Webhooks).
# The names must match the *_env values in your config file.
DISCORD_WEBHOOK_TEAM_A=
DISCORD_WEBHOOK_TEAM_B=
DISCORD_ISSUES_WEBHOOK=
